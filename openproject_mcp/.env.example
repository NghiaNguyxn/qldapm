# ============================================================================
# OpenProject Enterprise MCP Server — Environment Configuration (.env.example)
# ============================================================================

# 1. Core OpenProject API v3 Connection
OPENPROJECT_URL=http://26.65.103.140
OPENPROJECT_API_KEY=your_openproject_api_key_here
# Optional: Use OAuth2 Bearer token instead of Basic Auth (apikey:<key>)
OPENPROJECT_OAUTH_TOKEN=
# Optional: Default project ID or identifier slug when project_id is omitted
OPENPROJECT_PROJECT_ID=3

# 2. Defense-in-Depth Security & Boundary Guardrails
# Set to true to block all POST/PATCH/DELETE mutations (Read-Only mode)
OPENPROJECT_READ_ONLY=false
# Set to false to hide and block destructive DELETE tools
OPENPROJECT_ENABLE_DELETE_TOOLS=true
# Set to false to hide and block Admin-level user/group creation tools
OPENPROJECT_ENABLE_ADMIN_TOOLS=true
# Wrap untrusted descriptions/comments in <untrusted-openproject-content> tags
OPENPROJECT_SANITIZE_UNTRUSTED=true

# 3. Project Scope Allowlists (comma-separated project IDs, slugs, or glob patterns)
OPENPROJECT_READ_PROJECTS=*
OPENPROJECT_WRITE_PROJECTS=*

# 4. Network & Pagination Tuning
OPENPROJECT_TIMEOUT=30.0
OPENPROJECT_MAX_RETRIES=3
OPENPROJECT_DEFAULT_PAGE_SIZE=50
OPENPROJECT_MAX_PAGE_SIZE=200
OPENPROJECT_VERIFY_SSL=true
