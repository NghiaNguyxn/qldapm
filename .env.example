# Cấu hình xác thực Jira Cloud REST API v3 (Copy file này thành .env và điền token thực tế)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@stu.ptit.edu.vn
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=SCRUM

